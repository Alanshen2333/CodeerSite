# Flask
FLASK_APP=src/api/wsgi.py:app
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL
DATABASE_URL=postgresql+psycopg://codeersite:codeersite_dev@localhost:5432/codeersite

# MongoDB
MONGO_URI=mongodb://localhost:27017/codeersite

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET_KEY=change-me-to-another-random-secret-at-least-32-bytes

# Gitea (VCS backend)
GITEA_URL=http://localhost:23000
GITEA_ADMIN_USER=codeersite-admin
GITEA_ADMIN_PASS=codeersite-admin-dev
GITEA_ADMIN_TOKEN=        # scripts/init-gitea.sh 生成后填入
GITEA_ORG=codeersite
