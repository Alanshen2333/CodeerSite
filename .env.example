# Flask
FLASK_APP=src/api/wsgi.py:app
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL
DATABASE_URL=postgresql+psycopg://codeersite:codeersite_dev@localhost:5432/codeersite

# MongoDB
MONGO_URI=mongodb://localhost:27017/codeersite

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET_KEY=change-me-to-another-random-secret-at-least-32-bytes

# Gitea (VCS backend)
GITEA_URL=http://localhost:23000
GITEA_ADMIN_USER=codeersite-admin
GITEA_ADMIN_PASS=codeersite-admin-dev
GITEA_ADMIN_TOKEN=        # scripts/init-gitea.sh 生成后填入
GITEA_ORG=codeersite
# Fernet key，用于加密用户 Gitea token；32 bytes base64，可用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITEA_TOKEN_ENCRYPTION_KEY=
# 公开项目匿名读取仓库内容时使用的 Gitea token；未配置则回退到 ADMIN_TOKEN
GITEA_PUBLIC_READONLY_TOKEN=

# 头像上传（最大 2MB，后端会缩放至 512x512 后存 PG blob）
MAX_AVATAR_SIZE=2097152

# 邮箱验证码
EMAIL_CODE_TTL=300
# 邮件驱动：console（开发环境打印到日志）或 smtp
MAIL_DRIVER=console
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=noreply@codeer.site
